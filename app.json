{
  "expo": {
    "name": "Carchau",
    "slug": "Carchau",
    "version": "1.0.0",
    "scheme": "carchau",
    "newArchEnabled": true,
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "assets/Car-Logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-dev-launcher",
        {
          "launchMode": "most-recent"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "tsconfigPaths": true
    },
    "orientation": "portrait",
    "icon": "./assets/Car-Logo.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/Car-Logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#022036"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/Car-Logo.png",
        "backgroundColor": "#022036"
      },
      "package": "com.carloseduss.Carchau"
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "8ecdcdc9-04f7-4ad3-a5c6-2dd5e7bf1693"
      }
    },
    "owner": "carchau"
  }
}
