{
  "name": "carchau",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "build:dev": "eas build --profile development",
    "build:preview": "eas build --profile preview",
    "build:prod": "eas build --profile production",
    "prebuild": "expo prebuild",
    "lint": "eslint \"**/*.{js,jsx,ts,tsx}\" && prettier -c \"**/*.{js,jsx,ts,tsx,json}\"",
    "format": "eslint \"**/*.{js,jsx,ts,tsx}\" --fix && prettier \"**/*.{js,jsx,ts,tsx,json}\" --write",
    "web": "expo start --web"
  },
  "dependencies": {
    "@emailjs/react-native": "^4.2.2",
    "@expo/vector-icons": "^14.0.0",
    "@react-native-async-storage/async-storage": "1.23.1",
    "@react-native-community/datetimepicker": "8.2.0",
    "@react-native-firebase/app": "^22.4.0",
    "@react-native-firebase/firestore": "^22.4.0",
    "@react-native-picker/picker": "2.9.0",
    "@react-navigation/native": "^7.0.0",
    "@rneui/base": "^4.0.0-rc.7",
    "@rneui/themed": "^4.0.0-rc.8",
    "@stripe/stripe-react-native": "0.38.6",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "expo": "~52.0.47",
    "expo-constants": "~17.0.3",
    "expo-dev-client": "~5.0.20",
    "expo-document-picker": "~13.0.3",
    "expo-image-picker": "~16.0.6",
    "expo-linking": "~7.0.3",
    "expo-location": "~18.0.10",
    "expo-notifications": "~0.29.14",
    "expo-router": "~4.0.21",
    "expo-status-bar": "~2.0.0",
    "expo-system-ui": "~4.0.9",
    "expo-web-browser": "~14.0.2",
    "express": "^5.1.0",
    "firebase": "^11.7.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-native": "0.76.9",
    "react-native-calendars": "^1.1312.0",
    "react-native-date-picker": "^5.0.10",
    "react-native-gesture-handler": "~2.20.2",
    "react-native-gifted-chat": "^2.8.1",
    "react-native-image-picker": "^7.2.3",
    "react-native-maps": "^1.18.0",
    "react-native-mask-text": "^0.14.2",
    "react-native-masked-text": "^1.12.5",
    "react-native-pager-view": "6.5.1",
    "react-native-reanimated": "3.16.2",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-svg": "15.8.0",
    "react-native-web": "~0.19.10",
    "stripe": "^19.3.0"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@react-native-community/cli": "latest",
    "@types/express": "^5.0.5",
    "@types/node": "^24.10.0",
    "@types/react": "~18.3.12",
    "@typescript-eslint/eslint-plugin": "^7.7.0",
    "@typescript-eslint/parser": "^7.7.0",
    "eslint": "^8.57.0",
    "eslint-config-universe": "^12.0.1",
    "prettier": "^3.2.5",
    "ts-node-dev": "^2.0.0",
    "typescript": "~5.3.3"
  },
  "eslintConfig": {
    "extends": "universe/native",
    "root": true
  },
  "private": true,
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "@emailjs/react-native",
          "firebase",
          "@rneui/base",
          "@rneui/themed",
          "react-native-masked-text"
        ],
        "listUnknownPackages": false
      }
    }
  },
  "description": "This is an [Expo](https://expo.dev) project created with [`create-expo-app`](https://www.npmjs.com/package/create-expo-app).",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CarlosEduFF/Carchau.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/CarlosEduFF/Carchau/issues"
  },
  "homepage": "https://github.com/CarlosEduFF/Carchau#readme"
}
